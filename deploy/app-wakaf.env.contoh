# Salin ke /etc/app-wakaf.env lalu isi nilainya. chmod 600, milik root.
# SECRET_KEY dibuat dengan: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ganti_dengan_64_karakter_hex_acak
DB_PATH=/data/wakaf.db
UPLOAD_DIR=/data/berkas
# Tempat berkas unggahan: "lokal" (disk, bawaan) atau "s3".
# Balik ke "s3" hanya setelah `python -m scripts.pindah_s3 --periksa` bersih.
PENYIMPANAN=lokal
S3_BUCKET=
S3_PREFIX=dokumen
AWS_REGION=ap-southeast-3
TZ=Asia/Makassar
DEBUG=0
NAMA_KANTOR=Kantor Pertanahan Kabupaten Bone Bolango
# Hanya dipakai sekali saat database masih kosong.
ADMIN_PASSWORD=
